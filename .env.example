# ============================================
# Distributed File Storage System
# Root Environment Configuration
# ============================================

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=dfs_user
MYSQL_PASSWORD=dfs_password
MYSQL_DATABASE=distributed_file_storage
MYSQL_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend / Coordinator
BACKEND_PORT=4000

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000

# Storage Nodes
STORAGE_NODE_BASE_PORT=5001

# ============================================
# Backend / Coordinator Configuration
# ============================================

PORT=4000

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=dfs_user
MYSQL_PASSWORD=dfs_password
MYSQL_DATABASE=distributed_file_storage

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Storage Nodes (comma-separated URLs)
STORAGE_NODES=http://storage-node-1:5001,http://storage-node-2:5002,http://storage-node-3:5003,http://storage-node-4:5004

# Chunking Configuration (in bytes, default: 10MB = 10485760)
CHUNK_SIZE=10485760

# Storage Coordinator Configuration
STORAGE_NODE_TIMEOUT=5000
STORAGE_CONCURRENCY=4
REPLICATION_FACTOR=2
